# Copy as .env and fill in your API key.
# Choose ONE provider for the answers and another (or the same) for the embeddings.

# ============ FREE option: Google Gemini (recommended) ============
# Get a free API key at https://aistudio.google.com/app/apikey  (no card required)
LLM_PROVIDER=google
EMBEDDINGS_PROVIDER=google
GOOGLE_API_KEY=paste-your-google-key-here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# ============ OpenAI option (requires credit) ============
# To use OpenAI, set LLM_PROVIDER=openai and EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ============ Local embeddings (free, no key) ============
# Alternative: EMBEDDINGS_PROVIDER=huggingface (downloads a local model)
HF_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ============ Chatbot ============
BOT_NAME=Argentina Driving License
PDF_PATH=./data/manual.pdf
TEMPERATURE=0.1
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=4
ALLOWED_ORIGINS=*
