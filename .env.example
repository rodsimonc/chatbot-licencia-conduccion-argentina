# Copiá como .env y completá tu API key.

# --- OpenAI (respuestas y embeddings por defecto) ---
OPENAI_API_KEY=sk-...tu-key-aca...
CHAT_MODEL=gpt-4o-mini
TEMPERATURE=0.1

# --- Embeddings ---
# openai  -> usa OpenAI (necesita la key de arriba)
# huggingface -> embeddings locales gratis (no requieren key)
EMBEDDINGS_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
HF_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Chatbot ---
BOT_NAME=Licencia conducción Argentina
PDF_PATH=./data/manual.pdf

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=4

# CORS: orígenes permitidos para embeber el widget ("*" = cualquiera)
ALLOWED_ORIGINS=*
