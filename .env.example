# Copiá como .env y completá tu API key.
# Elegí UN proveedor para las respuestas y otro (o el mismo) para los embeddings.

# ============ Opción GRATIS: Google Gemini (recomendada) ============
# Sacá una API key gratis en https://aistudio.google.com/app/apikey  (sin tarjeta)
LLM_PROVIDER=google
EMBEDDINGS_PROVIDER=google
GOOGLE_API_KEY=pega-tu-key-de-google-aca
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# ============ Opción OpenAI (requiere crédito) ============
# Para usar OpenAI, poné LLM_PROVIDER=openai y EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ============ Embeddings locales (gratis, sin key) ============
# Alternativa: EMBEDDINGS_PROVIDER=huggingface (descarga un modelo local)
HF_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ============ Chatbot ============
BOT_NAME=Licencia conducción Argentina
PDF_PATH=./data/manual.pdf
TEMPERATURE=0.1
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=4
ALLOWED_ORIGINS=*
